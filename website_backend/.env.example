# Runtime configuration for the website backend.
# Copy this file to `.env` and adjust the values for your deployment.

# IP address the HTTP listener binds to.
SERVER_IP=0.0.0.0
# TCP port the HTTP listener binds to.
SERVER_PORT=3200
# Comma separated list of allowed CORS origins. Leave empty to allow none.
SERVER_CORS=https://aimer.cottonsofficial.com,http://localhost:3000
